# Firebase Web SDK config -- Firebase console > Project settings > Your apps > Web
# Copy to .env.local for local dev; set the same keys in your CI/build env for AWS.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Optional: pull the question bank from Firestore instead of the bundled fallback
VITE_USE_FIRESTORE_QUESTIONS=true

# Optional: restrict Google sign-in to one or more email domains.
# Empty (the default) accepts any Google account. Comma-separated for several.
# This is a UX gate -- see the commented rule in firestore.rules to enforce it
# server-side as well.
VITE_ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# Study guidance (server/index.mjs) -- read by the Node server, never bundled.
# Get a key at https://aistudio.google.com/apikey. Do NOT prefix it with VITE_:
# that would ship the key inside the public JS bundle.
GEMINI_API_KEY=
# Optional overrides. Fallbacks are tried in order when a model is overloaded
# (503 "high demand") or not available to the key.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# low (default) is ~30% faster; empty = the model's own default thinking
# GEMINI_THINKING_LEVEL=low
# GUIDANCE_PORT=8787

# Production only, when the guidance API is hosted apart from the static site.
# Default is /api/guidance, which the Vite dev/preview proxy forwards.
# VITE_GUIDANCE_API_URL=https://your-api.example.com/api/guidance
# GUIDANCE_ALLOWED_ORIGINS=https://your-site.example.com
